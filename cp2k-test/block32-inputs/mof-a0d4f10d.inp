&FORCE_EVAL
   METHOD Quickstep
   STRESS_TENSOR ANALYTICAL
   &DFT
      CHARGE 0
      BASIS_SET_FILE_NAME BASIS_MOLOPT
      POTENTIAL_FILE_NAME GTH_POTENTIALS
      &QS
         EPS_DEFAULT 1.0E-7
         EXTRAPOLATION_ORDER 3
         EXTRAPOLATION PS
      &END QS
      &PRINT
         &E_DENSITY_CUBE ON
            FILENAME =valence_density.cube
            STRIDE 1 1 1
         &END E_DENSITY_CUBE
      &END PRINT
      &SCF
         IGNORE_CONVERGENCE_FAILURE
         MAX_SCF 128
         &PRINT
            &RESTART OFF
            &END RESTART
         &END PRINT
         &MIXING
            METHOD BROYDEN_MIXING
            ALPHA 0.4
            NMIXING 16
         &END MIXING
      &END SCF
      &XC
         &XC_FUNCTIONAL PBE
         &END XC_FUNCTIONAL
         &VDW_POTENTIAL
            DISPERSION_FUNCTIONAL PAIR_POTENTIAL
            &PAIR_POTENTIAL
               TYPE DFTD3
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL PBE
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
      &END XC
      &MGRID
         NGRIDS 5
         REL_CUTOFF [Ry] 50
         CUTOFF [eV] 8.163415807310173477e+03
      &END MGRID
      &LS_SCF
         MAX_SCF 128
      &END LS_SCF
   &END DFT
   &PRINT
      &STRESS_TENSOR ON
      &END STRESS_TENSOR
   &END PRINT
